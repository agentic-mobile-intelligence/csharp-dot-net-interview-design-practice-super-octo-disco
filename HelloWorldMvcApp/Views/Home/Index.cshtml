@model HelloWorldMvcApp.Models.HomeViewModel

@{
    ViewData["Title"] = Model?.Title ?? "Home";
}

<div style="text-align: center;">
    <h1>@Model?.Title</h1>

    <div style="margin: 2rem 0; padding: 2rem; background: #f5f5f5; border-radius: 8px;">
        <p style="font-size: 1.2rem; color: #333;">
            @Model?.Message
        </p>
    </div>

    <div style="margin: 2rem 0; padding: 1rem; background: #e8f4f8; border-left: 4px solid #667eea; border-radius: 4px;">
        <p>
            <strong>Page Visits in This Session:</strong> <span style="font-size: 1.5rem; color: #667eea;">@Model?.VisitCount</span>
        </p>
    </div>

    <div style="margin: 2rem 0;">
        <h2 style="margin-bottom: 1rem;">📚 Application Features</h2>
        <ul style="text-align: left; display: inline-block; color: #666;">
            <li>✅ ASP.NET Core MVC Architecture</li>
            <li>✅ Model-View-Controller Separation</li>
            <li>✅ Dependency Injection</li>
            <li>✅ Logging Integration</li>
            <li>✅ Session Management</li>
            <li>✅ Blazor Integration Ready</li>
        </ul>
    </div>

    <div style="margin: 2rem 0; padding: 1.5rem; background: #f0f4ff; border-radius: 8px;">
        <h3>🎯 Architecture Highlights</h3>
        <p style="font-size: 0.95rem; color: #555;">
            This application demonstrates key design principles:
        </p>
        <ul style="text-align: left; display: inline-block; color: #555; font-size: 0.9rem;">
            <li><strong>SRP:</strong> HomeController handles only home page logic</li>
            <li><strong>OCP:</strong> Easy to add new controllers for new features</li>
            <li><strong>DIP:</strong> Logger injected via dependency injection</li>
            <li><strong>Clear Separation:</strong> Models, Views, Controllers are independent</li>
        </ul>
    </div>

    <div style="margin: 3rem 0;">
        <a href="@Url.Action("About")" class="btn">Learn More About This App</a>
    </div>
</div>
