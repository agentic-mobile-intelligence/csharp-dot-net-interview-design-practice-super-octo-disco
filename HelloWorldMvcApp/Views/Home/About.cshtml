@model HelloWorldMvcApp.Models.AboutViewModel

@{
    ViewData["Title"] = Model?.Title ?? "About";
}

<h1>@Model?.Title</h1>

<div style="margin: 2rem 0; padding: 1.5rem; background: #f5f5f5; border-radius: 8px;">
    <h2 style="margin-bottom: 1rem;">📖 About This Application</h2>
    <p>@Model?.Description</p>
</div>

<div style="margin: 2rem 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
    <div style="padding: 1.5rem; background: #e8f4f8; border-radius: 8px;">
        <h3>🏗️ Architecture</h3>
        <p>
            This is a classic MVC (Model-View-Controller) application built on ASP.NET Core,
            demonstrating proper separation of concerns and SOLID principles.
        </p>
    </div>

    <div style="padding: 1.5rem; background: #f0e8f8; border-radius: 8px;">
        <h3>🎓 Purpose</h3>
        <p>
            Created for interview preparation, showcasing understanding of enterprise architecture
            patterns and best practices in .NET development.
        </p>
    </div>

    <div style="padding: 1.5rem; background: #e8f8f0; border-radius: 8px;">
        <h3>👤 Author</h3>
        <p><strong>@Model?.Author</strong></p>
    </div>

    <div style="padding: 1.5rem; background: #f8f0e8; border-radius: 8px;">
        <h3>📦 Version</h3>
        <p><strong>@Model?.Version</strong></p>
    </div>
</div>

<div style="margin: 2rem 0; padding: 1.5rem; background: #fff5e6; border-left: 4px solid #ffa500; border-radius: 4px;">
    <h3>🔑 Key Design Patterns Used</h3>
    <ul style="color: #555; font-size: 0.95rem;">
        <li><strong>MVC Pattern:</strong> Separates presentation, logic, and data</li>
        <li><strong>Dependency Injection:</strong> Logger injected into controller</li>
        <li><strong>Repository-like Pattern:</strong> Data access separated from business logic</li>
        <li><strong>ViewModel Pattern:</strong> Data transfer objects between Controller and View</li>
        <li><strong>Single Responsibility:</strong> Each class has one reason to change</li>
    </ul>
</div>

<div style="margin: 3rem 0; text-align: center;">
    <a href="@Url.Action("Index")" class="btn">Back to Home</a>
</div>
